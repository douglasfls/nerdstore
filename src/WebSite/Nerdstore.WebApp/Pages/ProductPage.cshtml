@page "/products/{id:guid}"
@using Nerdstore.WebApp.Services
@model Nerdstore.WebApp.Pages.ProductPage
@{
    var product = Model.SelectedProduct ?? new();
}
<div class="container px-4 px-lg-5 my-5">
    <div class="row gx-4 gx-lg-5 align-items-center">
        <div class="col-md-6"><img class="card-img-top mb-5 mb-md-0"
                                   src="https://dummyimage.com/600x700/dee2e6/6c757d.jpg" alt="..."/></div>
        <div class="col-md-6">
            <div class="small mb-1">SKU: @product.Id</div>
            <h1 class="display-5 fw-bolder">@product.Name</h1>
            <div class="fs-5 mb-5">
                <span class="text-decoration-line-through">$@product.Price</span>
                <span>$@Math.Round(Model.SelectedProduct.Price * (decimal)0.9, 2))</span>
            </div>
            <p class="lead">@Model.SelectedProduct.Description</p>
            <form asp-antiforgery="true" method="POST">
                <div class="d-flex">
                    <input type="hidden" name="id" value="@product.Id"/>
                    <input class="form-control text-center me-3"
                           type="number" value="1"
                           asp-for="Quantity"
                           min="1" max="10" style="max-width: 3rem"/>
                    <button class="btn btn-outline-dark flex-shrink-0" type="submit">
                        <i class="bi-cart-fill me-1"></i>
                        Add to cart
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="container px-4 px-lg-5 mt-5">
    <h2 class="fw-bolder mb-4">Related products</h2>
    <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
        @foreach (var relatedProduct in Model.RelatedProducts ?? new())
        {
            <div class="col mb-5">
                <div class="card h-100">
                    <!-- Product image-->
                    <img class="card-img-top" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" alt="..."/>
                    <!-- Product details-->
                    <div class="card-body p-4">
                        <div class="text-center">
                            <!-- Product name-->
                            <h5 class="fw-bolder">@relatedProduct.Name</h5>
                            <!-- Product price-->
                            $@relatedProduct.Price
                        </div>
                    </div>
                    <!-- Product actions-->
                    <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                        <div class="text-center"><a class="btn btn-outline-dark mt-auto" asp-page="ProductPage"
                                                    asp-route-id="@relatedProduct.Id">View options</a></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>